# Copy to .env and replace every placeholder before deploying.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
FRONTEND_URL=https://app.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax

DB_NAME=ramaqs
DB_USER=ramaqs
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=database-host
DB_PORT=5432
REDIS_URL=redis://redis-host:6379/0

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=mailer@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=RAMAQS <no-reply@example.com>
WHATSAPP_ENABLED=False
